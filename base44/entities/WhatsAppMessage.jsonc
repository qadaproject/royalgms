{
  "name": "WhatsAppMessage",
  "type": "object",
  "properties": {
    "guest_id": {
      "type": "string",
      "description": "Reference to Guest (best-effort match by phone)"
    },
    "guest_name": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "E.164 normalized phone number of the conversation counterpart"
    },
    "direction": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ],
      "description": "in = received from guest, out = sent to guest"
    },
    "message_text": {
      "type": "string",
      "description": "Message body text"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "template",
        "image",
        "audio",
        "video",
        "document",
        "button",
        "interactive",
        "location",
        "unknown"
      ],
      "default": "text"
    },
    "template_name": {
      "type": "string",
      "description": "Meta template name (for outgoing template messages)"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "delivered",
        "read",
        "failed",
        "received",
        "pending"
      ],
      "default": "pending",
      "description": "Delivery status (Meta message_status for outgoing; received for incoming)"
    },
    "wa_message_id": {
      "type": "string",
      "description": "Meta message id (wamid) for matching webhook delivery updates"
    },
    "delivery_detail": {
      "type": "string"
    },
    "from_name": {
      "type": "string",
      "description": "WhatsApp profile name of the sender (incoming messages)"
    }
  },
  "required": [
    "phone",
    "direction"
  ]
}